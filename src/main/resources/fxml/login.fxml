<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.supportflow.controller.LoginController" styleClass="pantalla"><padding><Insets top="22" right="22" bottom="22" left="22"/></padding>
<center><VBox fx:id="panel" spacing="16" alignment="CENTER" maxWidth="570">
<Label text="SupportFlow" styleClass="encabezado"/>
<Label text="Gestión de incidencias informáticas e inventario IT" wrapText="true"/>
<Label fx:id="lbMensaje" wrapText="true" styleClass="aviso"/>
<VBox fx:id="accesoReal" spacing="12">
<Label text="Correo electrónico"/><TextField fx:id="tfEmail" promptText="Tu correo de Firebase"/>
<Label text="Contraseña"/><PasswordField fx:id="pfContrasena" promptText="Contraseña"/>
<HBox spacing="10"><Button fx:id="btnIniciar" text="Iniciar sesión" onAction="#onIniciarSesion"/><Button fx:id="btnRegistro" text="Registrarse" onAction="#onRegistro"/><Button fx:id="btnRecuperar" text="Recuperar contraseña" onAction="#onRecuperar"/></HBox>
<Label text="Si ya has intentado entrar y el correo no está verificado:" wrapText="true"/>
<HBox spacing="10"><Button fx:id="btnReenviar" text="Reenviar verificación" onAction="#onReenviar"/><Button fx:id="btnComprobar" text="Ya he verificado mi correo" onAction="#onComprobar"/></HBox>
</VBox>
<VBox fx:id="accesoDemo" spacing="12">
<Label text="DEMOSTRACIÓN · NO UTILIZA FIREBASE" styleClass="titulo"/>
<Label text="Elige un usuario ficticio. No se pide contraseña."/>
<ComboBox fx:id="cbUsuarioDemo" maxWidth="Infinity"/>
<Button fx:id="btnEntrarDemo" text="Entrar en DEMO" onAction="#onEntrarDemo"/>
</VBox>
</VBox></center>
</BorderPane>

